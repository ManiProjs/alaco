// Derived values are recalculated when their source variables change.
function main() {
    var price = 100;
    var quantity = 3;

    derive total = price * quantity;
    derive discount_available = total >= 250;

    println("Initial total: ${total}");
    println(discount_available);

    quantity = 1;
    println("Updated total: ${total}");
    println(discount_available);

    price = 300;
    println("Updated total: ${total}");
    println(discount_available);
}
