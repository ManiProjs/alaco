struct ServerConfig {
    port: int,
    tls_enabled: bool,
}

function effective_port(config: ServerConfig): int {
    if config.tls_enabled {
        return 443;
    }
    return config.port;
}

function main() {
    let config = ServerConfig {
        port: 8080,
        tls_enabled: true,
    };

    println("Effective port:");
    println(effective_port(config));
}
