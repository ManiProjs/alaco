function is_non_empty(value: string): bool {
    return value != "";
}

function is_in_range(value: int, lower: int, upper: int): bool {
    if value < lower {
        return false;
    }
    return value <= upper;
}

function is_positive(value: int): bool {
    return value > 0;
}

function is_non_negative(value: int): bool {
    return value >= 0;
}

function is_negative(value: int): bool {
    return value < 0;
}

function is_zero(value: int): bool {
    return value == 0;
}

function is_non_zero(value: int): bool {
    return value != 0;
}

function is_valid_port(value: int): bool {
    return value >= 1 and value <= 65535;
}

function is_valid_percentage(value: int): bool {
    return value >= 0 and value <= 100;
}

function is_valid_year(value: int): bool {
    return value >= 1 and value <= 9999;
}

function is_valid_ipv4_octet(value: int): bool {
    return value >= 0 and value <= 255;
}
