// Named state machines with an explicit transition graph.
// Register allowed edges before transitioning a machine.
function allow(machine: string, origin: string, to: string): bool {
    return __builtin_state_allow(machine, origin, to);
}

function create(machine: string, initial: string): bool {
    return __builtin_state_create(machine, initial);
}

function current(machine: string): string {
    return __builtin_state_current(machine);
}

// Returns false when the machine is unknown or the edge is not allowed.
function transition(machine: string, next: string): bool {
    return __builtin_state_transition(machine, next);
}

function reset(machine: string, initial: string): bool {
    return __builtin_state_reset(machine, initial);
}
