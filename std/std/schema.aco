// Versioned JSON envelopes. Migration functions remain ordinary Alaco code:
// read the stored version/payload, transform it, then write the new version.
function wrap(name: string, version: int, payload: string): string {
    return __builtin_schema_wrap(name, version, payload);
}

function name(document: string): string {
    return __builtin_schema_name(document);
}

function version(document: string): int {
    return __builtin_schema_version(document);
}

function payload(document: string): string {
    return __builtin_schema_payload(document);
}

function matches(document: string, expected_name: string, minimum_version: int, maximum_version: int): bool {
    return __builtin_schema_matches(document, expected_name, minimum_version, maximum_version);
}
