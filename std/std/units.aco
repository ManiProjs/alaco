function celsius_to_fahrenheit(value: float): float {
    return value * 1.8 + 32.0;
}

function fahrenheit_to_celsius(value: float): float {
    return (value - 32.0) / 1.8;
}

function kilometers_to_miles(value: float): float {
    return value * 0.621371;
}

function miles_to_kilometers(value: float): float {
    return value / 0.621371;
}

function kilograms_to_pounds(value: float): float {
    return value * 2.2046226218;
}

function pounds_to_kilograms(value: float): float {
    return value / 2.2046226218;
}

function meters_to_feet(value: float): float {
    return value * 3.280839895;
}

function feet_to_meters(value: float): float {
    return value / 3.280839895;
}

function liters_to_us_gallons(value: float): float {
    return value / 3.785411784;
}

function us_gallons_to_liters(value: float): float {
    return value * 3.785411784;
}

function meters_to_kilometers(value: float): float {
    return value / 1000.0;
}

function kilometers_to_meters(value: float): float {
    return value * 1000.0;
}

function centimeters_to_inches(value: float): float {
    return value / 2.54;
}

function inches_to_centimeters(value: float): float {
    return value * 2.54;
}

function seconds_to_minutes(value: float): float {
    return value / 60.0;
}

function minutes_to_seconds(value: float): float {
    return value * 60.0;
}

function hours_to_seconds(value: float): float {
    return value * 3600.0;
}

function bytes_to_kibibytes(value: int): int {
    return value / 1024;
}

function kibibytes_to_bytes(value: int): int {
    return value * 1024;
}
