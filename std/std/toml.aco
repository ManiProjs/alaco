// TOML configuration helpers support a limited subset of TOML 1.0: simple
// sections, single-line assignments, and string/integer/boolean scalars.
// Basic single-quoted literal strings are supported; arrays, multiline
// strings, dates, and array-of-tables are not supported. Keys in sections use
// dotted names such as "server.port".
// Accessors cover string, integer, and boolean scalar values.
function is_valid(text: string): bool {
    return __builtin_toml_is_valid(text);
}

// Top-level scalar keys only. Missing keys or type mismatches use fallback.
function has_key(text: string, key: string): bool {
    return __builtin_toml_has_key(text, key);
}

function get_string(text: string, key: string, fallback: string): string {
    return __builtin_toml_get_string(text, key, fallback);
}

function get_int(text: string, key: string, fallback: int): int {
    return __builtin_toml_get_int(text, key, fallback);
}

function get_bool(text: string, key: string, fallback: bool): bool {
    return __builtin_toml_get_bool(text, key, fallback);
}
