function rectangle_area(width: int, height: int): int {
    return width * height;
}

function rectangle_perimeter(width: int, height: int): int {
    return 2 * (width + height);
}

function squared_distance(x1: int, y1: int, x2: int, y2: int): int {
    let dx = x2 - x1;
    let dy = y2 - y1;
    return dx * dx + dy * dy;
}

function absolute(value: int): int {
    if value < 0 {
        return 0 - value;
    }
    return value;
}

function manhattan_distance(x1: int, y1: int, x2: int, y2: int): int {
    let dx = x2 - x1;
    let dy = y2 - y1;
    return absolute(dx) + absolute(dy);
}

function is_inside_rectangle(x: int, y: int, left: int, top: int, right: int, bottom: int): bool {
    if x < left {
        return false;
    }
    if x > right {
        return false;
    }
    if y < top {
        return false;
    }
    return y <= bottom;
}

function rectangle_diagonal_squared(width: int, height: int): int {
    return width * width + height * height;
}

function triangle_area(base: int, height: int): int {
    return (base * height) / 2;
}

function circle_area(radius: float): float {
    return 3.141592653589793 * radius * radius;
}

function circle_circumference(radius: float): float {
    return 2.0 * 3.141592653589793 * radius;
}
