function max(a: int, b: int): int {
    if a > b {
        return a;
    }

    return b;
}

function min(a: int, b: int): int {
    if a < b {
        return a;
    }

    return b;
}

function abs(value: int): int {
    if value < 0 {
        return 0 - value;
    }

    return value;
}

function square(value: int): int {
    return value * value;
}

function clamp(value: int, lower: int, upper: int): int {
    if value < lower {
        return lower;
    }

    if value > upper {
        return upper;
    }

    return value;
}

function is_even(value: int): bool {
    return value % 2 == 0;
}

function is_odd(value: int): bool {
    return value % 2 != 0;
}

function cube(value: int): int {
    return value * value * value;
}

function sign(value: int): int {
    if value < 0 {
        return -1;
    }
    if value > 0 {
        return 1;
    }
    return 0;
}

function in_range(value: int, lower: int, upper: int): bool {
    if value < lower {
        return false;
    }
    return value <= upper;
}

// Greatest common divisor of two integers (Euclidean algorithm).
function gcd(left: int, right: int): int {
    var a = abs(left);
    var b = abs(right);
    loop (while b != 0) {
        let remainder = a % b;
        a = b;
        b = remainder;
    }
    return a;
}

// Integer exponentiation. Non-positive exponents return 1.
function pow_int(base: int, exponent: int): int {
    var result = 1;
    var count = 0;
    loop (while count < exponent) {
        result = result * base;
        count = count + 1;
    }
    return result;
}

// Least common multiple. Returns zero when either input is zero.
function lcm(left: int, right: int): int {
    if left == 0 {
        return 0;
    }
    if right == 0 {
        return 0;
    }
    return abs((left / gcd(left, right)) * right);
}

function is_prime(value: int): bool {
    if value < 2 {
        return false;
    }
    var divisor = 2;
    loop (while divisor <= value / divisor) {
        if value % divisor == 0 {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}

// Factorial for 0..=20. Returns -1 for negative values or values that would
// overflow a signed 64-bit integer.
function factorial(value: int): int {
    if value < 0 or value > 20 {
        return -1;
    }
    var result = 1;
    var factor = 2;
    loop (while factor <= value) {
        result = result * factor;
        factor = factor + 1;
    }
    return result;
}

// Round integer division upward. Returns 0 for a zero divisor.
function ceil_div(value: int, divisor: int): int {
    if divisor == 0 {
        return 0;
    }
    let quotient = value / divisor;
    let remainder = value % divisor;
    if remainder != 0 and ((value > 0 and divisor > 0) or (value < 0 and divisor < 0)) {
        return quotient + 1;
    }
    return quotient;
}

function triangular(value: int): int {
    if value < 0 or value > 3037000499 {
        return -1;
    }
    return (value * (value + 1)) / 2;
}

function is_power_of_two(value: int): bool {
    if value <= 0 {
        return false;
    }
    var remaining = value;
    loop (while remaining % 2 == 0) {
        remaining = remaining / 2;
    }
    return remaining == 1;
}

// Return false for a zero divisor instead of evaluating remainder by zero.
function is_multiple_of(value: int, divisor: int): bool {
    if divisor == 0 {
        return false;
    }
    return value % divisor == 0;
}

// Return the first multiple of `step` greater than or equal to `value`.
// A non-positive step returns `value` unchanged.
function round_up_to_multiple(value: int, step: int): int {
    if step <= 0 {
        return value;
    }
    let remainder = value % step;
    if remainder == 0 {
        return value;
    }
    if value >= 0 {
        return value + step - remainder;
    }
    return value - remainder;
}
