function sum3(a: int, b: int, c: int): int {
    return a + b + c;
}

function average2(a: int, b: int): int {
    return (a + b) / 2;
}

function average3(a: int, b: int, c: int): int {
    return (a + b + c) / 3;
}

function min2(a: int, b: int): int {
    if a < b {
        return a;
    }
    return b;
}

function max2(a: int, b: int): int {
    if a > b {
        return a;
    }
    return b;
}

function min3(a: int, b: int, c: int): int {
    let first = min2(a, b);
    return min2(first, c);
}

function max3(a: int, b: int, c: int): int {
    let first = max2(a, b);
    return max2(first, c);
}

// Return the middle value without sorting or allocating a collection.
function median3(a: int, b: int, c: int): int {
    if a <= b {
        if b <= c {
            return b;
        }
        if a <= c {
            return c;
        }
        return a;
    }
    if a <= c {
        return a;
    }
    if b <= c {
        return c;
    }
    return b;
}

function sum4(a: int, b: int, c: int, d: int): int {
    return a + b + c + d;
}

function average4(a: int, b: int, c: int, d: int): int {
    return (a + b + c + d) / 4;
}

// Integer percentage. Returns 0 when total is zero.
function percentage(value: int, total: int): int {
    if total == 0 {
        return 0;
    }
    return (value * 100) / total;
}

function sum2(a: int, b: int): int {
    return a + b;
}

function sum5(a: int, b: int, c: int, d: int, e: int): int {
    return a + b + c + d + e;
}

function average5(a: int, b: int, c: int, d: int, e: int): int {
    return sum5(a, b, c, d, e) / 5;
}

function range3(a: int, b: int, c: int): int {
    return max3(a, b, c) - min3(a, b, c);
}
