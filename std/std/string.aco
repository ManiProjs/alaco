function concat(left: string, right: string): string {
    return left + right;
}

function is_empty(value: string): bool {
    return value == "";
}

function repeat_string(value: string, count: int): string {
    var result: string = "";
    loop (repeat count) {
        result = result + value;
    }
    return result;
}

function surround(value: string, wrapper: string): string {
    return wrapper + value + wrapper;
}

function join3(first: string, separator: string, second: string, third: string): string {
    return first + separator + second + separator + third;
}

function is_not_empty(value: string): bool {
    return value != "";
}

function concat3(first: string, second: string, third: string): string {
    return first + second + third;
}

function join4(first: string, separator: string, second: string, third: string, fourth: string): string {
    return first + separator + second + separator + third + separator + fourth;
}

function prefix_suffix(value: string, prefix: string, suffix: string): string {
    return prefix + value + suffix;
}
